{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "meetings-bot",
    "description": "Reads calendar reminders in #hal-invites and sends Hal to the meeting."
  },
  "features": {
    "bot_user": {
      "display_name": "meetings-bot",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "groups:history",
        "groups:read",
        "files:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
